{
  "name": "unisphere",
  "version": "1.0.0",
  "description": "UniSphere - Smart University Management & Learning Platform (jQuery, Node.js, Express, MySQL)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:setup": "node scripts/setupDb.js",
    "db:seed": "node scripts/seed.js",
    "create-admin": "node scripts/createAdmin.js",
    "test": "node scripts/prepareTestDb.js && node --require ./tests/setupEnv.js --test --test-concurrency=1 tests/*.test.js",
    "db:reset": "node scripts/resetDb.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0"
  }
}
